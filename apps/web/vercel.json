{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" },
    { "source": "/agent", "destination": "/index.html" },
    { "source": "/agent/:path*", "destination": "/index.html" },
    { "source": "/helper", "destination": "/index.html" },
    { "source": "/helper/:path*", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/demo/:path*", "destination": "/index.html" },
    { "source": "/verify", "destination": "/index.html" },
    { "source": "/verify/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
