{
  "tool_config": {
    "type": "webhook",
    "name": "set_trusted_contact",
    "description": "Save someone she trusts, to help her back in if she loses her phone or forgets her PIN. They never see or move her money. Optional: if she does not want one, move on.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/set_trusted_contact",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "name": {
            "type": "string",
            "description": "Their name."
          },
          "phone": {
            "type": "string",
            "description": "Their phone number."
          }
        },
        "required": [
          "phone"
        ]
      }
    }
  }
}