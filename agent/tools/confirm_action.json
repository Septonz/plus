{
  "tool_config": {
    "type": "webhook",
    "name": "confirm_action",
    "description": "Confirm a prepared action after she clearly says yes, only when the tool said she can confirm by voice. Never send a PIN. If the result says pin_required_on_screen, tell her to type her PIN on the screen.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/confirm_action",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "action_id": {
            "type": "string",
            "description": "The action_id returned by the prepare tool."
          }
        },
        "required": [
          "action_id"
        ]
      }
    }
  }
}
