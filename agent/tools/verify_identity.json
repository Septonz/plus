{
  "tool_config": {
    "type": "webhook",
    "name": "verify_identity",
    "description": "The identity step of sign-up. The photo is taken ON HER SCREEN ONLY, and no ID number is ever taken by voice (Plus never asks for Aadhaar). Call it with no arguments to hear what she should do on the screen next and why.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/verify_identity",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          }
        },
        "required": []
      }
    }
  }
}
