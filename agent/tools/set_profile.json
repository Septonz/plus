{
  "tool_config": {
    "type": "webhook",
    "name": "set_profile",
    "description": "Save her name and/or the language she likes. Pass only what she said.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/set_profile",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "name": {
            "type": "string",
            "description": "Her name as she said it."
          },
          "language": {
            "type": "string",
            "description": "The language she chose, in her words (\"Pidgin\", \"Yoruba\", \"Tamil\", \"English\")."
          }
        },
        "required": []
      }
    }
  }
}