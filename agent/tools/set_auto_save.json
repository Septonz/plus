{
  "tool_config": {
    "type": "webhook",
    "name": "set_auto_save",
    "description": "Prepare a change to how much of each incoming payment is saved automatically (0 to 30 percent). Nothing changes until she taps Yes on her screen. Read back the text, then tell her to check her screen.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/set_auto_save",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "percent": {
            "type": "number",
            "description": "The percentage she asked for, 0 to 30. Only a number she said; never guess."
          }
        },
        "required": [
          "percent"
        ]
      }
    }
  }
}
