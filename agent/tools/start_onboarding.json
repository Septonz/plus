{
  "tool_config": {
    "type": "webhook",
    "name": "start_onboarding",
    "description": "Call first when the conversation is a sign-up (no account yet). Returns which step she is on (name, language, phone, PIN, check it is you, wallet), what is done, and what to ask next. Her screen shows the same steps.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/start_onboarding",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          }
        },
        "required": []
      }
    }
  }
}