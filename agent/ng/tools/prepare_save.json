{
  "tool_config": {
    "type": "webhook",
    "name": "prepare_save",
    "description": "Prepare moving money from her wallet into her savings goal (her pot on Stellar, apart from her spending money). Then confirm_action after her Yes (PIN on screen above ₦5,000).",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/prepare_save",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "amount": {
            "type": "number",
            "description": "Amount to save in naira, a whole number she said (\"5k\" is 5000). Never guess."
          }
        },
        "required": [
          "amount"
        ]
      }
    }
  }
}
