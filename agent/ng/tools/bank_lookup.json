{
  "tool_config": {
    "type": "webhook",
    "name": "bank_lookup",
    "description": "The name the bank gives for an account number (simulated name enquiry). Use it before sending, and ask her if the name is right.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/bank_lookup",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "bank": {
            "type": "string",
            "description": "The bank, as she says it (\"Ironwood\"). The tool lists the banks if it doesn't know it."
          },
          "account_number": {
            "type": "string",
            "description": "The 10-digit account number, digits only."
          }
        },
        "required": [
          "bank",
          "account_number"
        ]
      }
    }
  }
}
