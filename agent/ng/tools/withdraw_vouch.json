{
  "tool_config": {
    "type": "webhook",
    "name": "withdraw_vouch",
    "description": "Withdraw a waiting vouch before the loan opens (\"stop vouching for Funmi\"). A vouch already on a loan can't be withdrawn.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/withdraw_vouch",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "name": {
            "type": "string",
            "description": "Whose vouch, e.g. \"Funmi\". Leave out if she has only one."
          },
          "vouch_id": {
            "type": "string",
            "description": "One vouch, from my_vouches."
          }
        },
        "required": []
      }
    }
  }
}
