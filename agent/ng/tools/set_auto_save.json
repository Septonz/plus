{
  "tool_config": {
    "type": "webhook",
    "name": "set_auto_save",
    "description": "Set auto-save: this percent of every money-in goes to her savings, after any loan payment. 0 turns it off. Moves no money now.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/set_auto_save",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "percent": {
            "type": "number",
            "description": "0, 5, 10 or 20 (0 turns it off)."
          }
        },
        "required": [
          "percent"
        ]
      }
    }
  }
}
