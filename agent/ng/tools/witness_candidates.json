{
  "tool_config": {
    "type": "webhook",
    "name": "witness_candidates",
    "description": "Who she can ask to confirm an asset: people from her ajo, people she pays, and her Plus agent. Only eligible people (verified ID, 6+ weeks with Plus, good standing) can witness.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/witness_candidates",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          }
        },
        "required": []
      }
    }
  }
}
