{
  "tool_config": {
    "type": "webhook",
    "name": "reject_action",
    "description": "Cancel a prepared action, or record her No to a cash-in an agent says she gave.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/reject_action",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "action_id": {
            "type": "string",
            "description": "The action_id from the prepare tool or from get_user."
          }
        },
        "required": [
          "action_id"
        ]
      }
    }
  }
}
