{
  "tool_config": {
    "type": "webhook",
    "name": "revoke_record_share",
    "description": "Stop a share (\"stop sharing my record\"): without share_id, every open code stops working.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/revoke_record_share",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "share_id": {
            "type": "string",
            "description": "One share, from record_shares. Leave out to revoke every open one."
          }
        },
        "required": []
      }
    }
  }
}
