{
  "tool_config": {
    "type": "webhook",
    "name": "share_record",
    "description": "Share her Plus record with a lender (\"share my record with the lender\"). Read back what the lender sees and what they never see; she types her PIN on screen; the one-time code (24 hours) appears on her screen only.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/share_record",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          }
        },
        "required": []
      }
    }
  }
}
