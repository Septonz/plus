{
  "tool_config": {
    "type": "webhook",
    "name": "prepare_cashout",
    "description": "Prepare a cash-out with a Plus agent. After her Yes she gets a 6-digit code on her screen to show the agent. Never read the code out loud.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/prepare_cashout",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "amount": {
            "type": "number",
            "description": "Cash-out amount in naira, a whole number she said (\"20k\" is 20000). Never guess."
          }
        },
        "required": [
          "amount"
        ]
      }
    }
  }
}
