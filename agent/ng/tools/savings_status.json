{
  "tool_config": {
    "type": "webhook",
    "name": "savings_status",
    "description": "Her savings goal: name, how much she has saved (read from her pot on Stellar), the goal, how much is left, and her auto-save setting. Use it when she asks about her savings.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/savings_status",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          }
        },
        "required": []
      }
    }
  }
}
