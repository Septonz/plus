{
  "tool_config": {
    "type": "webhook",
    "name": "prepare_loan_repay",
    "description": "Prepare a repayment to her loan from her wallet, any amount up to what she owes. Leave out the amount to repay it all.",
    "response_timeout_secs": 10,
    "api_schema": {
      "url": "https://qoqmnjzfjhpemwleipth.supabase.co/functions/v1/agent-tools/prepare_loan_repay",
      "method": "POST",
      "request_headers": {
        "x-plus-secret": {
          "secret_id": "<ELEVENLABS_SECRET_ID_FOR_PLUS_AGENT_SECRET>"
        }
      },
      "content_type": "application/json",
      "request_body_schema": {
        "type": "object",
        "properties": {
          "plus_session": {
            "type": "string",
            "dynamic_variable": "plus_session"
          },
          "caller_id": {
            "type": "string",
            "dynamic_variable": "system__caller_id"
          },
          "amount": {
            "type": "number",
            "description": "Amount in naira she said. Leave out to repay everything owed."
          }
        },
        "required": []
      }
    }
  }
}
