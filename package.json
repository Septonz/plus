{
  "name": "plus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "markets:sync": "node scripts/sync-markets.mjs",
    "markets:check": "node scripts/sync-markets.mjs --check",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "seed": "pnpm --filter @plus/client build && node scripts/seed.ts",
    "bindings": "node scripts/bindings.mjs",
    "seed:db": "pnpm --filter @plus/client build && node scripts/seed-db.ts",
    "staff:create": "node scripts/create-staff.ts",
    "test:functions": "deno test --no-config --node-modules-dir=none --allow-env=PIN_PEPPER,USER_REF_SECRET,AGENT_SHARED_SECRET,ALLOWED_ORIGINS --allow-read=supabase/functions supabase/functions/_shared/",
    "e2e": "node scripts/e2e.ts",
    "e2e:ng": "node scripts/e2e-ng.ts",
    "e2e:loan": "node scripts/e2e-loan.ts",
    "e2e:assets": "node scripts/e2e-assets.ts",
    "e2e:bank": "node scripts/e2e-bank-send.ts",
    "e2e:verify": "node scripts/e2e-verify.ts",
    "e2e:vouch": "node scripts/e2e-vouch.ts",
    "e2e:savings": "node scripts/e2e-savings.ts",
    "demo:new-user": "node scripts/demo-new-user.ts",
    "screens": "node scripts/screens.ts",
    "demo:logins": "node scripts/demo-logins.ts",
    "agents:sync": "node scripts/agents-sync.ts",
    "voice:coverage": "node scripts/voice-coverage.ts",
    "functions:check-jwt": "node scripts/check-verify-jwt.mjs",
    "bench:rpc": "deno run -A --no-config --node-modules-dir=none scripts/bench-rpc.ts",
    "bench:confirm": "node scripts/bench-confirm.ts",
    "warm": "node scripts/warm.ts",
    "demo:ready": "node scripts/demo-ready.ts",
    "demo:reset": "pnpm --filter @plus/client build && node scripts/demo-reset.ts"
  },
  "devDependencies": {
    "@plus/client": "workspace:*",
    "@stellar/stellar-sdk": "^16.4.1",
    "@supabase/supabase-js": "^2.119.0"
  }
}
