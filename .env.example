# Copy to .env (or apps/web/.env.local for VITE_* vars). Never commit real values.
# Server-side secrets live in Supabase secrets / Vault, not in .env files.

# Web app
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PLUS_CONTRACT_ID=
# Demo logins' password, written by pnpm seed:db (dev project only)
VITE_DEMO_LOGIN_PASSWORD=

# Stellar
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=
PLUS_CONTRACT_ID=
USDC_SAC_ID=
NGNT_SAC_ID=

# Voice agent -> agent-tools shared secret (set with: npx supabase secrets set AGENT_SHARED_SECRET=...)
AGENT_SHARED_SECRET=

# Key for user_ref = HMAC-SHA256(secret, phone). Server-only (npx supabase secrets set USER_REF_SECRET=...)
USER_REF_SECRET=

# Key for PIN hashes = HMAC-SHA256(pepper, salt || pin). Server-only (npx supabase secrets set PIN_PEPPER=...)
PIN_PEPPER=

# ElevenLabs (root .env.local; set as Supabase secrets, never shipped to the browser)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# HMAC key for the 15-minute voice session token (Supabase secret only, at least 32 chars)
VOICE_SESSION_SECRET=

# Local scripts only (root .env.local, gitignored)
# pnpm seed:db: your WhatsApp number in international format, so you can play Selvi
DEMO_SELVI_PHONE=
# pnpm staff:create: email of the staff demo user
DEMO_STAFF_EMAIL=

# SEP-31 test anchor
TEST_ANCHOR_DOMAIN=testanchor.stellar.org
